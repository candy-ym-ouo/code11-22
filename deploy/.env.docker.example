# 容器编排可调参数 —— 复制为 deploy/.env.docker 后按需修改：
#   cp deploy/.env.docker.example deploy/.env.docker
# 不复制也能起（compose 内置了下列默认值），但生产部署请至少修改数据库密码与 JWT_SECRET。

# ---- 访问地址 / 端口 ----
# 对外访问地址，必须与真实地址一致（用于邀请/分享链接、CORS）
APP_URL=http://localhost:8080
# 宿主机监听端口（容器内固定 8080）；上公网常改为 80
HTTP_PORT=8080
# 用域名 + HTTPS 后：
#   APP_URL=https://heirloom.example.com
#   HTTP_PORT=443
#   COOKIE_SECURE=true
COOKIE_SECURE=false

# ---- 数据库 ----
POSTGRES_USER=heirloom
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=heirloom

# ---- 认证 ----
# 生产必填：openssl rand -hex 32
# 留空时系统会自动生成并保存在 secrets 命名卷中（容器重建后会话不丢，但卷删除即失效）
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=14d

# ---- 注册 ----
PUBLIC_SIGNUP=false

# ---- 备份调度（容器时区 TZ）----
# 每天几点几分执行全量备份（默认 02:30 Asia/Shanghai）
BACKUP_HOUR=2
BACKUP_MIN=30
# 周几在备份后追加恢复演练（Mon/Tue/Wed/Thu/Fri/Sat/Sun；置空关闭）
DRILL_WEEKDAY=Sun
# 备份保留份数（按时间倒序，超出清理）
BACKUP_RETENTION_DAYS=30
# 启动容器时立即补一次备份（默认 false；迁移新机器时可设 true）
BACKUP_ON_START=false

# ---- 其他 ----
LOG_LEVEL=info
TZ=Asia/Shanghai
MIGRATE_ON_START=true
WORKER_ENABLED=true
TRASH_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7
