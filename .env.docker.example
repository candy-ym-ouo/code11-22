# ============================================================
# 容器编排环境配置（docker compose 专用，与本机开发的 .env 分开）
# 由 bash deploy.sh init 自动复制并填充密钥；也可手动复制本文件为 .env.docker。
# ============================================================

# ---- 对外访问 ----
# 浏览器实际访问地址（邀请/分享链接用它生成，必须与真实地址一致）
# 本机试用：http://localhost:4000 ；有域名：https://heirloom.example.com
APP_URL=http://localhost:4000
# 宿主机暴露端口（容器内固定 80）。被占用时改成 4001 等
PUBLISHED_PORT=4000
# 走 HTTPS（前面再套一层 Caddy/云负载均衡终止 TLS）时改为 true
COOKIE_SECURE=false
# 如需从宿主机直接连 PostgreSQL（psql / prisma studio），取消注释：
# DB_PUBLISH_PORT=5432

# ---- 数据库（deploy.sh init 会把密码替换为随机值）----
POSTGRES_USER=heirloom
POSTGRES_DB=heirloom
POSTGRES_PASSWORD=change-me-please

# ---- 认证（deploy.sh init 会生成 64 位随机值）----
# JWT_SECRET=

# ---- 注册策略 ----
# false：只能凭邀请加入（首个账号仍可自助注册，自动成为系统管理员）
PUBLIC_SIGNUP=false

# ---- 上传上限（单位 MB；改大 MAX_AUDIO_MB 时同步改 docker/nginx.conf 的 client_max_body_size）----
MAX_IMAGE_MB=25
MAX_AUDIO_MB=200
MAX_DOC_MB=50

# ---- 后台维护 ----
TRASH_RETENTION_DAYS=30
EXPORT_RETENTION_DAYS=7

# ---- 备份 ----
# 每日执行时刻（容器时区），24 小时制 HH:MM
BACKUP_TIME=02:30
# 保留完整备份份数（按时间倒序截断）
BACKUP_RETENTION_DAYS=14

# ---- 其他 ----
TZ=Asia/Shanghai
LOG_LEVEL=info
